{
	"extends": "./tsconfig.app.json",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
		"types": ["vite/client", "vitest/globals", "@testing-library/jest-dom/vitest"],
		"paths": {
			"@app/*": ["src/app/*"],
			"@pages/*": ["src/pages/*"],
			"@builder/*": ["src/builder/*"],
			"@components/*": ["src/components/*"],
			"@hooks/*": ["src/hooks/*"],
			"@store/*": ["src/store/*"],
			"@styles/*": ["src/styles/*"],
			"@assets/*": ["src/assets/*"],
			"@app-types/*": ["src/types/*"],
			"@uniq/shared": ["../../packages/shared/src/index.ts"],
			"@tests/*": ["tests/*"]
		}
	},
	"include": ["src/**/*.test.ts", "src/**/*.test.tsx", "tests"],
	"exclude": []
}
