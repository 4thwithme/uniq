{
	"name": "@uniq/frontend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"license": "UNLICENSED",
	"scripts": {
		"css-types": "typed-scss-modules \"src/**/*.module.scss\" --exportType default --nameFormat none --logLevel error",
		"css-types:watch": "typed-scss-modules \"src/**/*.module.scss\" --exportType default --nameFormat none --logLevel error --watch",
		"dev": "npm run css-types && vite",
		"build": "npm run css-types && tsc -b && vite build",
		"preview": "vite preview",
		"build:model": "node scripts/build-racket-model.ts",
		"type-check": "npm run css-types && tsc -b",
		"lint": "npm run css-types && eslint .",
		"lint:fix": "npm run css-types && eslint . --fix",
		"format": "prettier --write \"src/**/*.{ts,tsx,scss}\" \"tests/**/*.ts\" vite.config.ts",
		"code-quality-check": "npm run lint && npm run format && npm run type-check",
		"test:unit": "vitest run",
		"test:unit:coverage": "vitest run --coverage",
		"test": "npm run code-quality-check && npm run test:unit",
		"test:coverage": "npm run code-quality-check && npm run test:unit:coverage"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource/barlow-condensed": "^5.3.0",
		"@fontsource/geist-mono": "^5.3.0",
		"@react-three/drei": "^10.7.8",
		"@react-three/fiber": "^9.8.0",
		"@uniq/shared": "*",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^8.4.0",
		"three": "^0.186.0",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@gltf-transform/core": "^4.5.0",
		"@gltf-transform/extensions": "^4.5.0",
		"@gltf-transform/functions": "^4.5.0",
		"@react-three/eslint-plugin": "^0.1.2",
		"@react-three/test-renderer": "^9.1.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^24.13.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.186.0",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/coverage-v8": "^5.0.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.12.0",
		"jsdom": "^29.1.1",
		"meshoptimizer": "^1.3.0",
		"prettier": "^3.9.9",
		"sass": "^1.105.0",
		"typed-scss-modules": "^8.1.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"engines": {
		"node": ">=v24.13.0",
		"npm": ">=11.0.0"
	}
}
